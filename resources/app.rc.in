#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"

1 VERSIONINFO
 FILEVERSION 0,2,5,0
 PRODUCTVERSION 0,2,5,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PlayView Project\0"
            VALUE "FileDescription", "PlayView Capture Monitor\0"
            VALUE "FileVersion", "0.2.5.0\0"
            VALUE "InternalName", "PlayView\0"
            VALUE "OriginalFilename", "PlayView.exe\0"
            VALUE "ProductName", "PlayView\0"
            VALUE "ProductVersion", "0.2.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
